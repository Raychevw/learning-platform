# ============================================================================
# Studevo LMS — единая конфигурация для docker-compose и локального запуска.
# Скопируйте в .env и при необходимости измените значения.
# ============================================================================

# ---------------------------- Security --------------------------------------
# Секрет подписи JWT. ОБЯЗАТЕЛЬНО замените в любом окружении, кроме локального.
JWT_SECRET=change_me_super_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

# Демо-аккаунты (создаются auth-service при первом старте)
SEED_DEMO_DATA=true
DEMO_PASSWORD=123456

# Разрешать сдачу после дедлайна (работа помечается isLate и получает штраф)
ALLOW_LATE_SUBMISSION=true

# Разрешённый origin фронтенда (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------------------------- Databases -------------------------------------
# Каждый сервис имеет собственную БД (database-per-service).
# Для локального режима (-Infra local) — ваш PostgreSQL на 5432.
DB_HOST=localhost
DB_PORT=5432
DB_USER=lms
DB_PASSWORD=lms_secure_password

COURSE_DB_NAME=course_db
ASSIGNMENT_DB_NAME=assignment_db
AUTH_DB_NAME=auth_db
AUDIT_DB_NAME=audit_db
COMMUNICATION_DB_NAME=communication_db

# Локальные порты БД (в docker-compose)
COURSE_DB_PORT=5433
ASSIGNMENT_DB_PORT=5434
AUTH_DB_PORT=5435
AUDIT_DB_PORT=5436
COMMUNICATION_DB_PORT=5437

# Внутренний токен приёма аудита (gateway -> audit-service)
AUDIT_INGEST_TOKEN=change_me_super_long_random_secret_at_least_32_chars

# ---------------------------- Redis -----------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------- Object storage (MinIO / S3) -------------------
# local  — файлы на диске (без Docker), s3 — MinIO/S3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secret_key
S3_BUCKET=lms-files
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# MinIO web console
MINIO_CONSOLE_PORT=9001

# ---------------------------- Services / ports ------------------------------
API_GATEWAY_URL=http://localhost:3000
COURSE_SERVICE_URL=http://localhost:3001
ASSIGNMENT_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3003
AUDIT_SERVICE_URL=http://localhost:3004

GATEWAY_PORT=3000
COURSE_SERVICE_PORT=3001
ASSIGNMENT_SERVICE_PORT=3002
AUTH_SERVICE_PORT=3003
AUDIT_SERVICE_PORT=3004
COMMUNICATION_SERVICE_PORT=3005
COMMUNICATION_SERVICE_URL=http://localhost:3005

# ---------------------------- Frontend --------------------------------------
# Vite dev server. В production фронт собран в nginx и ходит на /api относительно.
VITE_API_BASE=
