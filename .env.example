# Global Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
USE_POSTGRES=true

# Databases:
# - course_db (Course Service)
# - assignment_db (Assignment Service)
# - lms_db (LMS Monolith)
LMS_DB_USER=lms_admin
LMS_DB_PASSWORD=lms_secure_password
LMS_DB_NAME=lms_db

# Microservice URLs
COURSE_SERVICE_URL=http://localhost:3001
ASSIGNMENT_SERVICE_URL=http://localhost:3002
