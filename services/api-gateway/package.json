{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway reverse proxy entrypoint for microservices",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node --loader ts-node/esm src/main.ts",
    "start:dev": "node --loader ts-node/esm --watch src/main.ts"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.2"
  }
}
