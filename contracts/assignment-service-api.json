    "/students": {
      "post": {
        "description": "Registers a new student profile in Student Bounded Context",
        "operationId": "StudentController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterStudentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid name or email"
          }
        },
        "summary": "Register student",
        "tags": [
          "Students"
        ]
      }
    },
    "/students/{id}": {
      "get": {
        "operationId": "StudentController_getStudent",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Student UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Student profile found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Student not found"
          }
        },
        "summary": "Get student by ID",
        "tags": [
          "Students"
        ]
      }
    },
    "/assignments": {
      "post": {
        "description": "Synchronously contacts Course Service with a 2-second timeout. Uses fallback if Course Service is unreachable.",
        "operationId": "AssignmentController_createAssignment",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAssignmentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Assignment created successfully (or degraded via fallback)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssignmentResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error in assignment payload"
          }
        },
        "summary": "Create an assignment",
        "tags": [
          "Assignments"
        ]
      },
      "get": {
        "description": "Returns all assignments across courses",
        "operationId": "AssignmentController_listAssignments",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of assignments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssignmentResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "List all assignments",
        "tags": [
          "Assignments"
        ]
      }
    },
    "/assignments/{id}": {
      "get": {
        "operationId": "AssignmentController_getAssignment",
