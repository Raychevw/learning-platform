  "info": {
    "title": "Assignment & Student Service API",
    "description": "Assignment Bounded Context: Student profiles, assignment submission, and grading contracts",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Assignments",
      "description": ""
    },
    {
      "name": "Students",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "RegisterStudentDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Olexandr Petrenko",
            "description": "Full student name"
          },
          "email": {
            "type": "string",
            "example": "olexandr.petrenko@univ.edu",
            "description": "Student email address"
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "StudentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "345e6789-e89b-12d3-a456-426614174002"
          },
          "name": {
            "type": "string",
            "example": "Olexandr Petrenko"
          },
          "email": {
            "type": "string",
            "example": "olexandr.petrenko@univ.edu"
          },
          "enrolledCourses": {
            "example": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "enrolledCourses"
        ]
      },
      "CreateAssignmentDto": {
        "type": "object",
        "properties": {
          "courseId": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000",
            "description": "Target Course UUID"
          },
          "title": {
            "type": "string",
            "example": "Lab 3: Service Decomposition",
            "description": "Title of the assignment"
          },
          "maxScore": {
            "type": "number",
            "example": 100,
            "description": "Maximum score possible"
          },
          "dueDate": {
            "type": "string",
            "example": "2026-12-31T23:59:59Z",
            "description": "ISO 8601 Due Date (must be in future)"
          }
        },
        "required": [
          "courseId",
          "title",
          "maxScore",
          "dueDate"
        ]
      },
      "AssignmentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "234e5678-e89b-12d3-a456-426614174001"
          },
          "courseId": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "courseTitle": {
            "type": "string",
            "example": "Clean Architecture & Microservices",
            "description": "Cached course title"
          },
          "title": {
            "type": "string",
            "example": "Lab 3: Service Decomposition"
          },
          "maxScore": {
            "type": "number",
            "example": 100
          },
          "dueDate": {
            "type": "string",
            "example": "2026-12-31T23:59:59.000Z"
          },
          "isCourseVerified": {
            "type": "boolean",
            "example": true,
            "description": "True if verified synchronously via Course Service, False if fallback used"
          },
          "fallbackNotice": {
            "type": "object",
            "example": null,
            "description": "Warning message if graceful degradation occurred"
          }
        },
        "required": [
          "id",
          "courseId",
          "courseTitle",
          "title",
          "maxScore",
          "dueDate",
          "isCourseVerified"
        ]
      },
      "CreateAssignmentBodyDto": {
        "type": "object",
        "properties": {}
      },
      "SubmitBodyDto": {
        "type": "object",
        "properties": {}
      },
      "GradeBodyDto": {
        "type": "object",
        "properties": {}
      },
      "CreateGroupBodyDto": {
        "type": "object",
        "properties": {}
      },
      "EnrollStudentBodyDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}