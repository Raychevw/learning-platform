    "/courses": {
      "post": {
        "description": "Creates a draft course in Course Bounded Context",
        "operationId": "CourseController_createCourse",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCourseDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Course created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error: Title cannot be empty"
          }
        },
        "summary": "Create a new course",
        "tags": [
          "Courses"
        ]
      },
      "get": {
        "description": "Returns all available courses in the catalog",
        "operationId": "CourseController_listCourses",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of courses returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CourseResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "List all courses",
        "tags": [
          "Courses"
        ]
      }
    },
    "/courses/{id}": {
      "get": {
        "description": "Synchronously queried by internal services and clients",
        "operationId": "CourseController_getCourse",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID of the course",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Course with specified ID not found"
          }
        },
        "summary": "Get course by ID",
        "tags": [
          "Courses"
        ]
      }
    },
    "/courses/{id}/publish": {
      "post": {
        "description": "Publishes course and emits course.published event to message broker",
        "operationId": "CourseController_publishCourse",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID of the course to publish",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course published and event emitted"
          },
          "400": {
            "description": "Course cannot be published without description"
          },
          "404": {
            "description": "Course not found"
          }
        },
        "summary": "Publish course (Idempotent)",
        "tags": [
          "Courses"
        ]
      }
    },
