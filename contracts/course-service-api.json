  "info": {
    "title": "Course Service API",
    "description": "Course Bounded Context: Course catalog, syllabus, and publishing contracts",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Courses",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "CreateCourseDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Clean Architecture & Microservices",
            "description": "Title of the course"
          },
          "description": {
            "type": "string",
            "example": "Hands-on practical guide to decomposing monoliths into services",
            "description": "Course syllabus and description"
          }
        },
        "required": [
          "title",
          "description"
        ]
      },
      "CourseResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "title": {
            "type": "string",
            "example": "Clean Architecture & Microservices"
          },
          "description": {
            "type": "string",
            "example": "Hands-on practical guide"
          },
          "isPublished": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "isPublished"
        ]
      }
    }
  }
}