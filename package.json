{
  "name": "studevo-lms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Studevo — университетская LMS: React SPA + микросервисы на NestJS (course, assignment, auth, gateway)",
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:services": "npm --prefix services/auth-service run build && npm --prefix services/course-service run build && npm --prefix services/assignment-service run build && npm --prefix services/api-gateway run build",
    "build:all": "npm run build:services && npm run build",
    "start:all": "powershell -ExecutionPolicy Bypass -File ./start-all.ps1",
    "stop:all": "powershell -ExecutionPolicy Bypass -File ./stop-all.ps1",
    "start:auth": "node services/auth-service/dist/main.js",
    "start:course": "node services/course-service/dist/main.js",
    "start:assignment": "node services/assignment-service/dist/main.js",
    "start:gateway": "node services/api-gateway/dist/main.js",
    "test": "vitest run services/",
    "test:services": "vitest run services/",
    "verify:lab3": "node scripts/verify-lab3.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.2"
  }
}
