{
  "name": "learning-platform-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "services/*",
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:all": "npm --prefix services/course-service run build && npm --prefix services/assignment-service run build && npm --prefix services/api-gateway run build && npm run build",
    "start:all": "powershell -ExecutionPolicy Bypass -File ./start-all.ps1",
    "stop:all": "powershell -ExecutionPolicy Bypass -File ./stop-all.ps1",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:course": "npm --prefix services/course-service start",
    "start:assignment": "npm --prefix services/assignment-service start",
    "start:gateway": "npm --prefix services/api-gateway start",
    "test:services": "vitest run services/"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
